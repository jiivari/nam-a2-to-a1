#!/usr/bin/env bash
# Convert NAM A2 captures to A1-standard .nam files.
# Usage: ./nam-a2-to-a1 [--input SIGNAL.wav] [--outdir DIR] [--steps N] [--template A1.nam] FILE.nam [FILE2.nam ...]
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NEW_PY="$HERE/.venv/bin/python"
OLD_PY="$HERE/.venv-a1/bin/python"
if [[ ! -x "$NEW_PY" || ! -x "$OLD_PY" ]]; then
  echo "Environments missing. Run ./setup.sh first." >&2
  exit 1
fi

INPUT=""
OUTDIR="."
STEPS=6000
TEMPLATE=""
FILES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --input) INPUT="$2"; shift 2 ;;
    --outdir) OUTDIR="$2"; shift 2 ;;
    --steps) STEPS="$2"; shift 2 ;;
    --template) TEMPLATE="$2"; shift 2 ;;
    -h|--help) sed -n 2,3p "$0"; exit 0 ;;
    *) FILES+=("$1"); shift ;;
  esac
done
[[ ${#FILES[@]} -gt 0 ]] || { sed -n 2,3p "$0"; exit 1; }

# Default training signal: the test signal the Ampero Editor itself writes when it
# imports a NAM file (macOS location). Pass --input on other systems.
if [[ -z "$INPUT" ]]; then
  INPUT="$HOME/Library/Application Support/com.hotone.mp380/wavs/nam_input_wav.wav"
fi
if [[ ! -f "$INPUT" ]]; then
  echo "Training signal not found: $INPUT" >&2
  echo "Pass --input SIGNAL.wav (see README)." >&2
  exit 1
fi

mkdir -p "$OUTDIR" "$HERE/work"
for f in "${FILES[@]}"; do
  base="$(basename "${f%.nam}")"
  npz="$HERE/work/$base.npz"
  out="$OUTDIR/$base (A1).nam"
  echo "== $base"
  "$NEW_PY" "$HERE/render_teacher.py" "$f" "$npz" --input "$INPUT"
  extra=()
  [[ -n "$TEMPLATE" ]] && extra=(--template "$TEMPLATE")
  "$OLD_PY" "$HERE/a2_to_a1.py" "$npz" "$out" --steps "$STEPS" ${extra[@]+"${extra[@]}"} \
    2> >(grep -v -i -E 'warn|pkg_resources' >&2)
  rm -f "$npz"
done
